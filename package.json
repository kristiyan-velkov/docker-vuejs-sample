{
  "name": "my-vue-app",
  "version": "0.0.1",
  "homepage": "https://github.com/kristiyan-velkov/frontend-prod-dockerfiles",
  "author": {
    "name": "Kristiyan Velkov",
    "url": "https://www.linkedin.com/in/kristiyan-velkov-763130b3/"
  },
  "bugs": {
    "url": "https://github.com/kristiyan-velkov/frontend-prod-dockerfiles/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kristiyan-velkov"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run --environment jsdom --reporter verbose",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "cypress": "16.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "jsdom": "30.1.2",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.10",
    "start-server-and-test": "3.0.13",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  }
}
